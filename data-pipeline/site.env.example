# Copy to site.env (gitignored) and fill in. Read by auto_import.py.

# Your deployed site - the nightly privacy check confirms it refuses anonymous visitors.
AM_SITE_URL=https://your-project.pages.dev
# The Cloudflare Pages project name used by `wrangler pages deploy`.
AM_PAGES_PROJECT=adventure-map
# The folder of geotagged photos to scan (defaults to the OneDrive Camera Roll).
AM_PHOTO_DIR=C:\Users\you\Pictures\Camera Roll
