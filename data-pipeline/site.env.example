# Copy to site.env (gitignored) and fill in. Read by auto_import.py and import_activities.py.

# The folder of geotagged photos to scan (defaults to the OneDrive Camera Roll).
AM_PHOTO_DIR=C:\Users\you\Pictures\Camera Roll
# The folder of GPS activity files (FIT, GPX, TCX, optionally .gz) exported from any
# watch or app. Defaults to data-pipeline\activities.
#AM_ACTIVITIES_DIR=C:\Users\you\Documents\Activities

# 1 = leave trips that have no photos (only tracks) out of the Trips panel.
AM_TRIPS_NEED_PHOTOS=0

# Match `editing` in web/site.js. 0 = read-only: places come from places.geojson.
# 1 = editing: places live in the D1 database and are backed up every night.
AM_EDITING=0

# How to publish the site after each import (run in web/). Pick one, or neither if
# your host rebuilds from your git repo.
#AM_DEPLOY_CMD=netlify deploy --prod --dir .
#AM_PAGES_PROJECT=adventure-map

# Your deployed site. With AM_PRIVATE=1 the nightly run checks that it still refuses
# anonymous visitors; set AM_PRIVATE=0 for a public map.
AM_SITE_URL=https://your-site.example.com
AM_PRIVATE=1
