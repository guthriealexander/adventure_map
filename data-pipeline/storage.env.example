# Copy to storage.env (gitignored). Where upload.py publishes photos, tiles and data.
# web/site.js `mediaBase` must point at the same place.

# Option 1: a folder published with the site (mediaBase: 'media'). Simplest; good for
# a few thousand photos. Most static hosts cap file counts or sizes, so use a bucket
# for a big library.
STORAGE=folder
FOLDER=../web/media

# Option 2: any S3-compatible bucket: Cloudflare R2, AWS S3, Backblaze B2, Wasabi,
# MinIO... (mediaBase: '/media' with Cloudflare Pages Functions, or the bucket's
# public URL). A public bucket needs CORS allowing GET and Range from your site.
#STORAGE=s3
#S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # leave out for AWS S3
#S3_REGION=auto                                              # e.g. us-west-2 for AWS
#S3_BUCKET=photos
#S3_ACCESS_KEY_ID=your-access-key-id
#S3_SECRET_ACCESS_KEY=your-secret-access-key
